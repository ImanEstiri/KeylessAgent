<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="ImanSoftware.KeylessAgent.Cli"/>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- Per-Monitor-V2 DPI awareness: without it, a process running at a non-100% display
           scale gets OS-VIRTUALIZED values from GetSystemMetrics/SPI_GETWORKAREA (logical
           pixels), which do not match the physical pixel grid a separately-launched,
           DPI-aware Chrome renders into. The tiny-corner window geometry is computed from
           these APIs, so the CLI (which launches Chrome and moves the window) must see
           physical pixels. -->
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
