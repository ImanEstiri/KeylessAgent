<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Glass panels (guide 5.3 layer 3): translucent fill, 1 px border, radius 16. -->

    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GlassCardGradient}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="GlassCardStrong" TargetType="Border" BasedOn="{StaticResource GlassCard}">
        <Setter Property="Background" Value="{DynamicResource GlassFillStrong}" />
        <Setter Property="Padding" Value="24" />
    </Style>

    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GlassFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="12,4" />
    </Style>

</ResourceDictionary>
