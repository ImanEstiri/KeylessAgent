<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:ImanSoftware.KeylessAgent.Wpf.ViewModels.Dialogs"
                    xmlns:views="clr-namespace:ImanSoftware.KeylessAgent.Wpf.Views.Dialogs">

    <!-- Dialog views are selected by their view-model type (guide Phase 5). -->

    <DataTemplate DataType="{x:Type vm:ConfirmDialogViewModel}">
        <views:ConfirmDialogView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ChoiceDialogViewModel}">
        <views:ChoiceDialogView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:AskDialogViewModel}">
        <views:AskDialogView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ErrorDialogViewModel}">
        <StackPanel MinWidth="420" Margin="24">
            <TextBlock Text="{Binding Title}" Style="{DynamicResource SubtitleText}" Foreground="{DynamicResource Danger}" />
            <TextBlock Text="{Binding Message}" Style="{DynamicResource BodyText}" TextWrapping="Wrap" Margin="0,12,0,0" />
            <Button Content="OK"
                    Style="{DynamicResource PrimaryButton}"
                    Command="{Binding OkCommand}"
                    IsDefault="True"
                    IsCancel="True"
                    MinWidth="110"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0" />
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
