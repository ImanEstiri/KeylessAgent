<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:feed="clr-namespace:ImanSoftware.KeylessAgent.Wpf.ViewModels.Feed"
                    xmlns:views="clr-namespace:ImanSoftware.KeylessAgent.Wpf.Views">

    <!-- Feed item views (guide Phase 6): one DataTemplate per feed item type. -->

    <DataTemplate DataType="{x:Type feed:UserRequestItem}">
        <Border Background="{DynamicResource GlassFillStrong}"
                BorderBrush="{DynamicResource Gold}"
                BorderThickness="1,0,0,0"
                CornerRadius="6"
                Padding="12,8"
                Margin="0,2">
            <StackPanel>
                <TextBlock Text="You" Style="{DynamicResource CaptionText}" Foreground="{DynamicResource Gold}" />
                <TextBlock Text="{Binding Message}" Style="{DynamicResource BodyText}" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type feed:ModelMessageItem}">
        <Border Background="{DynamicResource GlassFill}"
                BorderBrush="{DynamicResource GlassBorder}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,8"
                Margin="0,2">
            <StackPanel>
                <TextBlock Text="◆ Model" Style="{DynamicResource CaptionText}" Foreground="{DynamicResource TextSecondary}" />
                <TextBlock Text="{Binding Message}" Style="{DynamicResource BodyText}" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type feed:StepItem}">
        <StackPanel Orientation="Horizontal" Margin="4,3">
            <TextBlock Text="{Binding Symbol}" Style="{DynamicResource BodyText}" Foreground="{DynamicResource Gold}" Margin="0,0,8,0" />
            <TextBlock Text="{Binding Label}" Style="{DynamicResource BodyText}" />
            <TextBlock Text="{Binding Detail}" Style="{DynamicResource CaptionText}" Foreground="{DynamicResource TextMuted}"
                       VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type feed:CommandItem}">
        <StackPanel Orientation="Horizontal" Margin="4,3">
            <TextBlock Text="{Binding Number, StringFormat='#{0}'}" Style="{DynamicResource MonoText}" Foreground="{DynamicResource Gold}" Margin="0,0,8,0" />
            <TextBlock Text="{Binding Kind}" Style="{DynamicResource MonoText}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0" />
            <TextBlock Text="{Binding Target}" Style="{DynamicResource MonoText}" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type feed:DiffItem}">
        <views:DiffView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type feed:ErrorItem}">
        <TextBlock Text="{Binding Message}" Style="{DynamicResource BodyText}" Foreground="{DynamicResource Danger}"
                   TextWrapping="Wrap" Margin="4,3" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type feed:TurnSummaryItem}">
        <Border Background="{DynamicResource GlassFillStrong}"
                BorderBrush="{DynamicResource GlassBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,10"
                Margin="0,4">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{DynamicResource BodyText}" Foreground="{DynamicResource Gold}">
                        <Run Text="Turn " /><Run Text="{Binding Turn, Mode=OneWay}" /><Run Text=" on " /><Run Text="{Binding Branch, Mode=OneWay}" />
                    </TextBlock>
                    <Border Background="{DynamicResource GlassFill}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                            Visibility="{Binding DryRun, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="dry-run" Style="{DynamicResource CaptionText}" Foreground="{DynamicResource Info}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding StoppedReason}" Style="{DynamicResource CaptionText}" Foreground="{DynamicResource Warning}"
                           TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="{Binding StoppedReason, Converter={StaticResource NullToCollapsed}}" />
                <ItemsControl ItemsSource="{Binding Commits}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{DynamicResource CaptionText}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap">
                                <Run Text="• " /><Run Text="{Binding Mode=OneWay}" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Summary}" Style="{DynamicResource BodyText}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="{Binding Summary, Converter={StaticResource NullToCollapsed}}" />
                <TextBlock Style="{DynamicResource CaptionText}" Foreground="{DynamicResource TextMuted}" Margin="0,6,0,0">
                    <Run Text="Auto-approved: " /><Run Text="{Binding AutoApprovedCommands, Mode=OneWay}" /><Run Text=" | Confirmed: " /><Run Text="{Binding ConfirmedCommands, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Border>
    </DataTemplate>

</ResourceDictionary>
