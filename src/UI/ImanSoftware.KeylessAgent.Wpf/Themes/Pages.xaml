<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:ImanSoftware.KeylessAgent.Wpf.ViewModels"
                    xmlns:views="clr-namespace:ImanSoftware.KeylessAgent.Wpf.Views">

    <!-- Page views are selected by their view-model type through the shell navigation. -->

    <DataTemplate DataType="{x:Type vm:AgentViewModel}">
        <views:AgentView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:WorkspaceViewModel}">
        <views:WorkspaceView />
    </DataTemplate>

</ResourceDictionary>
