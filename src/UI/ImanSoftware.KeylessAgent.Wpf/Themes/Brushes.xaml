<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- One brush per color token; views reference these via DynamicResource. -->

    <SolidColorBrush x:Key="BgDeep" Color="{StaticResource BgDeep}" />
    <SolidColorBrush x:Key="BgMid" Color="{StaticResource BgMid}" />

    <SolidColorBrush x:Key="GlassFill" Color="{StaticResource GlassFill}" />
    <SolidColorBrush x:Key="GlassFillHover" Color="{StaticResource GlassFillHover}" />
    <SolidColorBrush x:Key="GlassFillStrong" Color="{StaticResource GlassFillStrong}" />
    <SolidColorBrush x:Key="GlassBorder" Color="{StaticResource GlassBorder}" />

    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="TextMuted" Color="{StaticResource TextMuted}" />

    <SolidColorBrush x:Key="Gold" Color="{StaticResource Gold}" />
    <SolidColorBrush x:Key="GoldHover" Color="{StaticResource GoldHover}" />
    <SolidColorBrush x:Key="GoldPressed" Color="{StaticResource GoldPressed}" />

    <SolidColorBrush x:Key="Violet" Color="{StaticResource Violet}" />

    <SolidColorBrush x:Key="Success" Color="{StaticResource Success}" />
    <SolidColorBrush x:Key="Warning" Color="{StaticResource Warning}" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource Danger}" />
    <SolidColorBrush x:Key="Info" Color="{StaticResource Info}" />

    <SolidColorBrush x:Key="DiffAdd" Color="{StaticResource DiffAdd}" />
    <SolidColorBrush x:Key="DiffRemove" Color="{StaticResource DiffRemove}" />

    <!-- Derived convenience gradients -->
    <LinearGradientBrush x:Key="WindowFallbackGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource BgDeep}" Offset="0" />
        <GradientStop Color="{StaticResource BgMid}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassCardGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1FFFFFFF" Offset="0" />
        <GradientStop Color="#0AFFFFFF" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
