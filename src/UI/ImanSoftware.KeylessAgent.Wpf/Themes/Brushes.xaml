<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- One brush per color token; views reference these via DynamicResource. -->

    <SolidColorBrush x:Key="BgDeep" Color="{DynamicResource BgDeep}" />
    <SolidColorBrush x:Key="BgMid" Color="{DynamicResource BgMid}" />

    <SolidColorBrush x:Key="GlassFill" Color="{DynamicResource GlassFill}" />
    <SolidColorBrush x:Key="GlassFillHover" Color="{DynamicResource GlassFillHover}" />
    <SolidColorBrush x:Key="GlassFillStrong" Color="{DynamicResource GlassFillStrong}" />
    <SolidColorBrush x:Key="GlassBorder" Color="{DynamicResource GlassBorder}" />

    <SolidColorBrush x:Key="TextPrimary" Color="{DynamicResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondary" Color="{DynamicResource TextSecondary}" />
    <SolidColorBrush x:Key="TextMuted" Color="{DynamicResource TextMuted}" />

    <SolidColorBrush x:Key="Gold" Color="{DynamicResource Gold}" />
    <SolidColorBrush x:Key="GoldHover" Color="{DynamicResource GoldHover}" />
    <SolidColorBrush x:Key="GoldPressed" Color="{DynamicResource GoldPressed}" />

    <SolidColorBrush x:Key="Violet" Color="{DynamicResource Violet}" />

    <SolidColorBrush x:Key="Success" Color="{DynamicResource Success}" />
    <SolidColorBrush x:Key="Warning" Color="{DynamicResource Warning}" />
    <SolidColorBrush x:Key="Danger" Color="{DynamicResource Danger}" />
    <SolidColorBrush x:Key="Info" Color="{DynamicResource Info}" />

    <SolidColorBrush x:Key="DiffAdd" Color="{DynamicResource DiffAdd}" />
    <SolidColorBrush x:Key="DiffRemove" Color="{DynamicResource DiffRemove}" />

    <!-- Derived convenience gradients -->
    <LinearGradientBrush x:Key="WindowFallbackGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource BgDeep}" Offset="0" />
        <GradientStop Color="{DynamicResource BgMid}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassCardGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1FFFFFFF" Offset="0" />
        <GradientStop Color="#0AFFFFFF" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
