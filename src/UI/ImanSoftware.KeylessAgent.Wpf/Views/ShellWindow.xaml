<Window x:Class="ImanSoftware.KeylessAgent.Wpf.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeylessAgent"
        Width="1280" Height="800"
        WindowStyle="None"
        Background="Transparent"
        ResizeMode="CanResize"
        PreviewKeyDown="OnShellPreviewKeyDown">

    <Window.Resources>
        <!-- Sidebar nav item: transparent chrome, hover glow, gold highlight on the active page. -->
        <Style x:Key="NavItemButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GlassFillHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GlassFillStrong}" />
                                <Setter Property="Foreground" Value="{DynamicResource Gold}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="-1"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <!-- Layer 1: app-drawn fallback gradient (visible when no system backdrop). -->
        <Border x:Name="FallbackBackground" Background="{DynamicResource WindowFallbackGradient}" />

        <!-- Layer 2: blurred orbs, non-hit-testable, behind all content. -->
        <Canvas x:Name="OrbCanvas" IsHitTestVisible="False">
            <Ellipse Width="520" Height="520" Canvas.Left="-140" Canvas.Top="-120"
                     Fill="{DynamicResource Violet}" Opacity="0.16">
                <Ellipse.Effect>
                    <BlurEffect Radius="110" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="420" Height="420" Canvas.Right="-100" Canvas.Top="120"
                     Fill="{DynamicResource Gold}" Opacity="0.10">
                <Ellipse.Effect>
                    <BlurEffect Radius="100" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="380" Height="380" Canvas.Left="300" Canvas.Bottom="-160"
                     Fill="{DynamicResource Info}" Opacity="0.10">
                <Ellipse.Effect>
                    <BlurEffect Radius="90" />
                </Ellipse.Effect>
            </Ellipse>
        </Canvas>

        <!-- Layer 4: the actual window layout (title bar, sidebar, content, status bar). -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Title bar spans both columns; draggable via WindowChrome.CaptionHeight. -->
            <Grid Grid.Row="0" Grid.ColumnSpan="2" Background="Transparent">
                <TextBlock Text="◆ KeylessAgent - ImanSoftware"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"
                           Style="{DynamicResource SubtitleText}" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton"
        Width="46" Height="32"
        Style="{StaticResource GhostButton}"
        Padding="0"
        Click="OnMinimizeClick"
        ToolTip="Minimize">
                        <Path Data="M 0,5 L 10,5"
          Stroke="{DynamicResource TextPrimary}"
          StrokeThickness="1"
          StrokeStartLineCap="Round"
          StrokeEndLineCap="Round"
          HorizontalAlignment="Center"
          VerticalAlignment="Center" />
                    </Button>

                    <Button x:Name="MaximizeButton"
        Width="46" Height="32"
        Style="{StaticResource GhostButton}"
        Padding="0"
        Click="OnMaximizeClick"
        ToolTip="Maximize / restore">
                        <Path Data="M 0,0 L 10,0 L 10,10 L 0,10 Z"
          Stroke="{DynamicResource TextPrimary}"
          StrokeThickness="1"
          Fill="Transparent"
          HorizontalAlignment="Center"
          VerticalAlignment="Center" />
                    </Button>

                    <Button x:Name="CloseButton"
        Width="46" Height="32"
        Style="{StaticResource DangerButton}"
        Padding="0"
        Click="OnCloseClick"
        ToolTip="Close">
                        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10"
          Stroke="{DynamicResource TextPrimary}"
          StrokeThickness="1"
          StrokeStartLineCap="Round"
          StrokeEndLineCap="Round"
          HorizontalAlignment="Center"
          VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Sidebar navigation bound to the shell view model (guide Phase 4/6). -->
            <Border Grid.Row="1" Grid.Column="0"
                    Background="{DynamicResource GlassFill}"
                    BorderBrush="{DynamicResource GlassBorder}"
                    BorderThickness="0,1,1,0">
                <ItemsControl ItemsSource="{Binding NavItems}" Margin="8,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{DynamicResource NavItemButton}"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Key}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Symbol}" Width="24" />
                                    <TextBlock Text="{Binding Title}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Content area: the current page from the shell navigation. -->
            <Border Grid.Row="1" Grid.Column="1"
                    Background="{DynamicResource GlassFill}"
                    BorderBrush="{DynamicResource GlassBorder}"
                    BorderThickness="1,1,0,0">
                <ContentControl x:Name="ContentHost" Content="{Binding CurrentPage}" />
            </Border>

            <!-- Status bar; bound to the Chrome section (connection kind). -->
            <Border Grid.Row="2" Grid.ColumnSpan="2"
                    Background="{DynamicResource GlassFill}"
                    BorderBrush="{DynamicResource GlassBorder}"
                    BorderThickness="0,1,0,0"
                    Padding="16,4">
                <TextBlock x:Name="StatusBarText" Text="{Binding StatusText}" Style="{DynamicResource CaptionText}" Foreground="{DynamicResource TextMuted}" />
            </Border>
        </Grid>

        <!-- Layer 5: modal dialog overlay (Phase 5); visible while the dialog host shows a view model. -->
        <Grid x:Name="DialogOverlay"
              Background="#B3000000"
              Visibility="{Binding HasCurrent, Converter={StaticResource BoolToVisibility}}">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="420"
                    MaxWidth="680"
                    MaxHeight="620"
                    Background="{DynamicResource GlassFillStrong}"
                    BorderBrush="{DynamicResource GlassBorder}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Style="{DynamicResource FadeIn}">
                <ContentControl Content="{Binding Current}" Focusable="False" />
            </Border>
        </Grid>
    </Grid>
</Window>
