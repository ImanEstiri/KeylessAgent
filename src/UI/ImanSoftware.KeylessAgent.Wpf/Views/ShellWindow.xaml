<Window x:Class="ImanSoftware.KeylessAgent.Wpf.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeylessAgent"
        Width="1280" Height="800"
        WindowStyle="None"
        Background="Transparent"
        ResizeMode="CanResize">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="-1"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <!-- Layer 1: app-drawn fallback gradient (visible when no system backdrop). -->
        <Border x:Name="FallbackBackground" Background="{DynamicResource WindowFallbackGradient}" />

        <!-- Layer 2: blurred orbs, non-hit-testable, behind all content. -->
        <Canvas x:Name="OrbCanvas" IsHitTestVisible="False">
            <Ellipse Width="520" Height="520" Canvas.Left="-140" Canvas.Top="-120"
                     Fill="{DynamicResource Violet}" Opacity="0.16">
                <Ellipse.Effect>
                    <BlurEffect Radius="110" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="420" Height="420" Canvas.Right="-100" Canvas.Top="120"
                     Fill="{DynamicResource Gold}" Opacity="0.10">
                <Ellipse.Effect>
                    <BlurEffect Radius="100" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="380" Height="380" Canvas.Left="300" Canvas.Bottom="-160"
                     Fill="{DynamicResource Info}" Opacity="0.10">
                <Ellipse.Effect>
                    <BlurEffect Radius="90" />
                </Ellipse.Effect>
            </Ellipse>
        </Canvas>

        <!-- Layer 4: the actual window layout (title bar, sidebar, content, status bar). -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Title bar spans both columns; draggable via WindowChrome.CaptionHeight. -->
            <Grid Grid.Row="0" Grid.ColumnSpan="2" Background="Transparent">
                <TextBlock Text="◆ KeylessAgent"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"
                           Style="{DynamicResource SubtitleText}" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton"
                            Width="46" Height="32"
                            Style="{StaticResource GhostButton}"
                            Content="▢" Click="OnMinimizeClick" />
                    <Button x:Name="MaximizeButton"
                            Width="46" Height="32"
                            Style="{StaticResource GhostButton}"
                            Content="▢" Click="OnMaximizeClick" />
                    <Button x:Name="CloseButton"
                            Width="46" Height="32"
                            Style="{StaticResource DangerButton}"
                            Content="✕" Click="OnCloseClick" />
                </StackPanel>
            </Grid>

            <!-- Sidebar with the five navigation targets (visual only in Phase 3). -->
            <Border Grid.Row="1" Grid.Column="0"
                    Background="{DynamicResource GlassFill}"
                    BorderBrush="{DynamicResource GlassBorder}"
                    BorderThickness="0,1,1,0">
                <StackPanel Margin="8,12">
                    <TextBlock Text="▶  Agent" Style="{DynamicResource BodyText}" Padding="12,8" />
                    <TextBlock Text="▣  Workspace" Style="{DynamicResource BodyText}" Padding="12,8" Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Text="✚  Doctor" Style="{DynamicResource BodyText}" Padding="12,8" Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Text="⚙  Settings" Style="{DynamicResource BodyText}" Padding="12,8" Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Text="ⓘ  About" Style="{DynamicResource BodyText}" Padding="12,8" Foreground="{DynamicResource TextSecondary}" />
                </StackPanel>
            </Border>

            <!-- Content area: navigation target from Phase 4. -->
            <Border Grid.Row="1" Grid.Column="1"
                    Background="{DynamicResource GlassFill}"
                    BorderBrush="{DynamicResource GlassBorder}"
                    BorderThickness="1,1,0,0">
                <ContentControl x:Name="ContentHost" />
            </Border>

            <!-- Status bar -->
            <Border Grid.Row="2" Grid.ColumnSpan="2"
                    Background="{DynamicResource GlassFill}"
                    BorderBrush="{DynamicResource GlassBorder}"
                    BorderThickness="0,1,0,0"
                    Padding="16,4">
                <TextBlock Text="Ready" Style="{DynamicResource CaptionText}" />
            </Border>
        </Grid>
    </Grid>
</Window>
