<UserControl x:Class="ImanSoftware.KeylessAgent.Wpf.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- About page: name, version, description, disclaimer, ToS warning, open folder. -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16" MaxWidth="760" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="◆" Foreground="{DynamicResource Gold}" Style="{DynamicResource DisplayText}" Margin="0,0,12,0" />
                <TextBlock Text="{Binding Name}" Style="{DynamicResource DisplayText}" />
            </StackPanel>
            <TextBlock Text="{Binding Version, StringFormat='Version {0}'}"
                       Style="{DynamicResource CaptionText}"
                       Foreground="{DynamicResource TextMuted}"
                       Margin="0,4,0,0" />

            <TextBlock Text="{Binding Description}"
                       Style="{DynamicResource BodyText}"
                       TextWrapping="Wrap"
                       Margin="0,16,0,0" />

            <Border Background="{DynamicResource GlassFill}"
                    BorderBrush="{DynamicResource GlassBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Not affiliated with DeepSeek" Style="{DynamicResource BodyText}" Foreground="{DynamicResource Info}" />
                    <TextBlock Text="{Binding Disclaimer}" Style="{DynamicResource CaptionText}" Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource GlassFill}"
                    BorderBrush="{DynamicResource Danger}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="⚠ Terms of service and account risk" Style="{DynamicResource BodyText}" Foreground="{DynamicResource Danger}" />
                    <TextBlock Text="{Binding Warning}" Style="{DynamicResource CaptionText}" Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="Open application folder"
                        Style="{DynamicResource GhostButton}"
                        Command="{Binding OpenRepositoryFolderCommand}"
                        MinWidth="170"
                        ToolTip="{Binding RepositoryFolder}" />
            </StackPanel>
            <TextBlock Text="{Binding Note}"
                       Style="{DynamicResource CaptionText}"
                       Foreground="{DynamicResource Warning}"
                       Margin="0,8,0,0"
                       Visibility="{Binding Note, Converter={StaticResource NullToCollapsed}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
