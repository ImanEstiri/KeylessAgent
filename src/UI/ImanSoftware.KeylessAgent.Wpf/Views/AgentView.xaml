<UserControl x:Class="ImanSoftware.KeylessAgent.Wpf.Views.AgentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inf="clr-namespace:ImanSoftware.KeylessAgent.Wpf.Infrastructure"
             xmlns:vm="clr-namespace:ImanSoftware.KeylessAgent.Wpf.ViewModels">
    <!-- Agent page: activity feed + composer (left), changes + summary + undo panel (right). -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <inf:NarrowPanelVisibilityConverter x:Key="NarrowPanel" />
        <inf:RtlFlowDirectionConverter x:Key="RtlFlowDirection" />
        <inf:RtlTextAlignmentConverter x:Key="RtlTextAlignment" />
        <!-- Undo section of the Changes panel. -->
        <DataTemplate DataType="{x:Type vm:UndoViewModel}">
            <StackPanel>
                <Button Content="Undo latest backups"
                        Style="{DynamicResource DangerButton}"
                        Command="{Binding UndoCommand}"
                        MinWidth="170"
                        ToolTip="Restores the newest backup batch (.agent/backups) after confirmation" />
                <TextBlock Text="Restores the latest backups. Changes made by commands cannot be undone."
                           Style="{DynamicResource CaptionText}"
                           Foreground="{DynamicResource TextMuted}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />
                <TextBlock Text="{Binding Note}"
                           Style="{DynamicResource CaptionText}"
                           Foreground="{DynamicResource Warning}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"
                           Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl ItemsSource="{Binding RestoredFiles}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{DynamicResource CaptionText}" Foreground="{DynamicResource TextSecondary}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding}">
                                <Run Text="✓ " /><Run Text="{Binding Mode=OneWay}" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="480" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Feed and composer -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: workspace path (trimmed in the middle, full path in the tooltip) + branch pill. -->
            <StackPanel Orientation="Horizontal" Margin="4,0,4,10"
                        Visibility="{Binding HasWorkspace, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="▣" Foreground="{DynamicResource Gold}" Style="{DynamicResource BodyText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="{Binding WorkspaceRootDisplay}"
                           Style="{DynamicResource BodyText}"
                           Foreground="{DynamicResource TextSecondary}"
                           ToolTip="{Binding WorkspaceRoot}"
                           VerticalAlignment="Center" />
                <Border Background="{DynamicResource GlassFillStrong}"
                        BorderBrush="{DynamicResource Gold}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10,2"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding BranchName, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Text="{Binding BranchName}" Style="{DynamicResource CaptionText}" Foreground="{DynamicResource Gold}" />
                </Border>
            </StackPanel>

            <Border Grid.Row="1" Style="{DynamicResource GlassCard}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Feed.Items}"
                                  Margin="8"
                                  inf:FeedScrollBehavior.Enabled="True" />
                </ScrollViewer>
            </Border>

            <Border Grid.Row="2"
                    Style="{DynamicResource GlassCard}"
                    Margin="0,12,0,0"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="ComposerBox"
                             Text="{Binding RequestText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="72"
                             MaxHeight="220"
                             VerticalScrollBarVisibility="Auto"
                             FlowDirection="{Binding RequestText, Converter={StaticResource RtlFlowDirection}}"
                             TextAlignment="{Binding RequestText, Converter={StaticResource RtlTextAlignment}}">
                        <TextBox.InputBindings>
                            <KeyBinding Modifiers="Control" Key="Enter" Command="{Binding SendCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                        <Ellipse Width="10"
                                 Height="10"
                                 Fill="{DynamicResource Gold}"
                                 Style="{DynamicResource PulseDot}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,10,0"
                                 Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                        <CheckBox Content="Dry run"
                                  Style="{DynamicResource ToggleSwitch}"
                                  IsChecked="{Binding DryRun}" />
                        <Button Content="Send"
                                Style="{DynamicResource PrimaryButton}"
                                Command="{Binding SendCommand}"
                                IsDefault="True"
                                MinWidth="110"
                                Margin="12,0,0,0" />
                        <Button Content="Stop"
                                Style="{DynamicResource DangerButton}"
                                Command="{Binding StopCommand}"
                                MinWidth="90"
                                Margin="12,0,0,0"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Changes and last summary; collapses on narrow windows (< 1100 px). -->
        <Border Grid.Column="1"
                Width="300"
                Margin="12,0,0,0"
                Style="{DynamicResource GlassCard}"
                Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NarrowPanel}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <TextBlock Text="Changes" Style="{DynamicResource BodyText}" Foreground="{DynamicResource Gold}" />
                    <ItemsControl ItemsSource="{Binding ChangedFiles}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="{Binding Kind}"
                                               Style="{DynamicResource CaptionText}"
                                               Foreground="{DynamicResource Gold}"
                                               Width="72" />
                                    <TextBlock Text="{Binding Path}"
                                               Style="{DynamicResource CaptionText}"
                                               Foreground="{DynamicResource TextSecondary}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ContentControl Content="{Binding LastSummary}" Margin="0,16,0,0" />
                    <ContentControl Content="{Binding Undo}" Margin="0,16,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
