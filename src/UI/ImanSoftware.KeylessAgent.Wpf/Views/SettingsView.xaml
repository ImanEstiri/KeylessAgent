<UserControl x:Class="ImanSoftware.KeylessAgent.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Settings page: UI-only settings (persisted via wpf-settings.json) + read-only keyless.json groups. -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16" MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{DynamicResource TitleText}" />
            <TextBlock Text="UI preferences are stored per user; the workspace configuration is read from keyless.json."
                       Style="{DynamicResource BodyText}"
                       Foreground="{DynamicResource TextSecondary}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0" />

            <!-- UI-only settings -->
            <Border Style="{DynamicResource GlassCard}" Margin="0,16,0,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="UI settings" Style="{DynamicResource BodyText}" Foreground="{DynamicResource Gold}" />
                    <CheckBox Content="Reduce effects (no backdrop spheres, no animations)"
                              Style="{DynamicResource ToggleSwitch}"
                              IsChecked="{Binding ReduceEffects}"
                              Margin="0,8,0,0" />
                    <CheckBox Content="Dry run by default"
                              Style="{DynamicResource ToggleSwitch}"
                              IsChecked="{Binding DryRunDefault}"
                              Margin="0,6,0,0" />
                    <CheckBox Content="Send with Enter (Shift+Enter for a new line)"
                              Style="{DynamicResource ToggleSwitch}"
                              IsChecked="{Binding SendWithEnter}"
                              Margin="0,6,0,0" />
                    <CheckBox Content="Verbose diagnostics for turns"
                              Style="{DynamicResource ToggleSwitch}"
                              IsChecked="{Binding Verbose}"
                              Margin="0,6,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Backdrop" Style="{DynamicResource BodyText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <ComboBox ItemsSource="{Binding BackdropChoices}"
                                  SelectedItem="{Binding BackdropPreference}"
                                  MinWidth="140" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- keyless.json -->
            <Border Style="{DynamicResource GlassCard}" Margin="0,12,0,0" Padding="12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="keyless.json (read-only)" Style="{DynamicResource BodyText}" Foreground="{DynamicResource Gold}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Open keyless.json"
                                    Style="{DynamicResource GhostButton}"
                                    Command="{Binding OpenKeylessJsonCommand}"
                                    MinWidth="140" />
                            <Button Content="Reload"
                                    Style="{DynamicResource GhostButton}"
                                    Command="{Binding ReloadCommand}"
                                    MinWidth="90"
                                    Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding Note}"
                               Style="{DynamicResource BodyText}"
                               Foreground="{DynamicResource Warning}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="●" Foreground="{DynamicResource Gold}" Style="{DynamicResource BodyText}" Margin="0,0,8,0" />
                        <TextBlock Text="Loading keyless.json…" Style="{DynamicResource BodyText}" Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Groups}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource GlassFill}"
                                        BorderBrush="{DynamicResource GlassBorder}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,8"
                                        Margin="0,4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Style="{DynamicResource BodyText}" Foreground="{DynamicResource TextSecondary}" />
                                        <ItemsControl ItemsSource="{Binding Rows}" Margin="8,4,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="220" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Key}" Style="{DynamicResource MonoText}"
                                                                   Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{DynamicResource MonoText}"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
