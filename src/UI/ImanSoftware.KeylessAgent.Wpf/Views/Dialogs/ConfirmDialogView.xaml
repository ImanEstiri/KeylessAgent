<UserControl x:Class="ImanSoftware.KeylessAgent.Wpf.Views.Dialogs.ConfirmDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Confirm: title, details in a selectable monospace box, Approve (gold, Enter) / Decline (ghost, Esc). -->
    <StackPanel Margin="24">
        <TextBlock Text="{Binding Title}"
                   Style="{DynamicResource SubtitleText}"
                   TextWrapping="Wrap" />
        <Border Background="{DynamicResource GlassFill}"
                BorderBrush="{DynamicResource GlassBorder}"
                BorderThickness="1"
                CornerRadius="8"
                MaxHeight="220"
                Margin="0,16">
            <TextBox Text="{Binding Details, Mode=OneWay}"
                     IsReadOnly="True"
                     FontFamily="{DynamicResource MonoFontFamily}"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Background="Transparent"
                     BorderThickness="0" />
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Decline"
                    Style="{DynamicResource GhostButton}"
                    Command="{Binding DeclineCommand}"
                    MinWidth="110" />
            <Button Content="Approve"
                    Style="{DynamicResource PrimaryButton}"
                    Command="{Binding ApproveCommand}"
                    IsDefault="True"
                    MinWidth="110" Margin="12,0,0,0" />
        </StackPanel>
    </StackPanel>
</UserControl>
