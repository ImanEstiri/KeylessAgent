<Window x:Class="ImanSoftware.KeylessAgent.Wpf.Views.FullAccessConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Full access (workspace only)"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="&#9888; Full access (workspace only)"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="#C8A24B"
                   Margin="0,0,0,8" />
        <TextBlock Text="Commands will run automatically WITHOUT asking — including ones that modify or delete files."
                   TextWrapping="Wrap"
                   Margin="0,0,0,6" />
        <TextBlock Text="They are still refused if they would touch anything outside this workspace folder."
                   TextWrapping="Wrap"
                   Foreground="#8F98B5"
                   Margin="0,0,0,12" />
        <CheckBox x:Name="UnderstandCheckBox"
                  Content="I understand — commands can modify or delete files in this workspace"
                  Checked="{x:Null}"
                  Unchecked="{x:Null}"
                  Margin="0,0,0,12" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    MinWidth="90"
                    Margin="0,0,8,0"
                    Click="OnCancelClick" />
            <Button x:Name="OkButton"
                    Content="OK"
                    MinWidth="90"
                    IsEnabled="False"
                    Style="{DynamicResource DangerButton}"
                    Click="OnOkClick" />
        </StackPanel>
    </StackPanel>
</Window>
