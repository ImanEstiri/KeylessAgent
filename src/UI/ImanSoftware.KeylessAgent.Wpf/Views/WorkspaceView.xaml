<UserControl x:Class="ImanSoftware.KeylessAgent.Wpf.Views.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Workspace page: current selection + Browse, note/loading states, capabilities, recent cards. -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- Transparent full-width chrome for the recent-workspace cards. -->
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource GlassFillHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MutedRow" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasRecents}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Workspace" Style="{DynamicResource TitleText}" />
            <TextBlock Text="Pick the folder the agent works in. The selection is remembered and shown in the agent header."
                       Style="{DynamicResource BodyText}"
                       Foreground="{DynamicResource TextSecondary}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0" />

            <!-- Current selection + Browse -->
            <Border Style="{DynamicResource GlassCard}" Margin="0,16,0,0" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Current workspace" Style="{DynamicResource CaptionText}" Foreground="{DynamicResource TextMuted}" />
                        <TextBlock Text="{Binding SelectedPath}"
                                   Style="{DynamicResource MonoText}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,8,0"
                                   Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="No folder selected yet."
                                   Style="{DynamicResource BodyText}"
                                   Foreground="{DynamicResource TextMuted}"
                                   Margin="0,2,0,0"
                                   Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Browse…"
                            Style="{DynamicResource GhostButton}"
                            Command="{Binding BrowseCommand}"
                            MinWidth="110"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Note and loading state -->
            <TextBlock Text="{Binding Note}"
                       Style="{DynamicResource BodyText}"
                       Foreground="{DynamicResource Warning}"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0"
                       Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                        Visibility="{Binding IsInspecting, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="●" Foreground="{DynamicResource Gold}" Style="{DynamicResource BodyText}" Margin="0,0,8,0" />
                <TextBlock Text="Checking the workspace…" Style="{DynamicResource BodyText}" Foreground="{DynamicResource TextSecondary}" />
            </StackPanel>

            <!-- Capabilities -->
            <ItemsControl ItemsSource="{Binding Capabilities}" Margin="0,10,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource GlassFill}"
                                BorderBrush="{DynamicResource GlassBorder}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,6"
                                Margin="0,3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" Style="{DynamicResource BodyText}" />
                                <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{DynamicResource MonoText}"
                                           Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="2" CornerRadius="4" Padding="8,1" Background="{DynamicResource GlassFillStrong}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource DiffRemove}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Ok}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource DiffAdd}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style BasedOn="{StaticResource CaptionText}" TargetType="TextBlock">
                                                <Setter Property="Text" Value="no" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Ok}" Value="True">
                                                        <Setter Property="Text" Value="ok" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Recent workspaces -->
            <TextBlock Text="Recent workspaces" Style="{DynamicResource BodyText}" Foreground="{DynamicResource Gold}" Margin="0,20,0,4" />
            <TextBlock Text="No recent workspaces yet — Browse… to pick a folder."
                       Style="{DynamicResource MutedRow}"
                       Foreground="{DynamicResource TextMuted}"
                       Margin="0,4,0,0" />
            <ItemsControl ItemsSource="{Binding Recents}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource GlassFill}"
                                BorderBrush="{DynamicResource GlassBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8"
                                Margin="0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{DynamicResource CardButton}" Command="{Binding OpenCommand}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Style="{DynamicResource BodyText}" />
                                            <Border Background="{DynamicResource GlassFillStrong}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                                    Visibility="{Binding IsNewest, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="last used" Style="{DynamicResource CaptionText}" Foreground="{DynamicResource Gold}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Path}"
                                                   Style="{DynamicResource CaptionText}"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1"
                                        Content="✕"
                                        Style="{DynamicResource DangerButton}"
                                        Width="34"
                                        MinHeight="30"
                                        Command="{Binding RemoveCommand}"
                                        VerticalAlignment="Center"
                                        ToolTip="Remove from the recent list" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
